---
import BrandIcon from "./BrandIcon.astro";
import { site } from "@/data/site";
---

<header class="site-header" data-header>
  <a class="site-header__brand" href="#top" aria-label={`${site.name} トップへ`}>
    <span class="site-header__brand-mark" aria-hidden="true">
      <span class="site-header__brand-mountain"></span>
    </span>
    <span class="site-header__brand-copy">
      <span class="site-header__brand-kicker">SAToyama SCHOOL</span>
      <span class="site-header__brand-name">{site.name}</span>
    </span>
  </a>

  <nav class="desktop-nav" aria-label="メインナビゲーション">
    <ul class="desktop-nav__list">
      {site.navigation.map((item) => (
        <li class="desktop-nav__item"><a class="desktop-nav__link" href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <a class="site-header__contact" href={site.phone.href}>
    <span class="site-header__contact-label">お電話</span>
    <span class="site-header__contact-number">{site.phone.display}</span>
  </a>

  <button class="menu-button" type="button" aria-label="メニューを開く" aria-controls="mobile-menu" aria-expanded="false" data-menu-button>
    <span class="menu-button__label">MENU</span>
    <span class="menu-button__lines" aria-hidden="true">
      <span class="menu-button__line"></span>
      <span class="menu-button__line"></span>
    </span>
  </button>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true" data-mobile-menu>
  <div class="mobile-menu__inner">
    <p class="mobile-menu__kicker">SAToyama SCHOOL</p>
    <p class="mobile-menu__name">{site.name}</p>
    <nav class="mobile-menu__nav" aria-label="モバイルナビゲーション">
      <ul class="mobile-menu__list">
        {site.navigation.map((item, index) => (
          <li class="mobile-menu__item">
            <span class="mobile-menu__number">0{index + 1}</span>
            <a class="mobile-menu__link" href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mobile-menu__contacts">
      <a class="mobile-menu__phone" href={site.phone.href}>{site.phone.display}</a>
      <div class="mobile-menu__socials">
        {site.socials.map((social) => (
          <a class="mobile-menu__social" href={social.href} target="_blank" rel="noopener noreferrer">
            <BrandIcon name={social.icon} size={20} />
            <span>{social.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>
