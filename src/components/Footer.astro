---
import BrandIcon from "./BrandIcon.astro";
import { site } from "@/data/site";
---

<footer class="site-footer">
  <div class="site-footer__inner site-container">
    <div class="site-footer__brand">
      <p class="site-footer__kicker">SAToyama SCHOOL</p>
      <p class="site-footer__name">{site.name}</p>
      <p class="site-footer__address">{site.address}</p>
    </div>
    <nav class="site-footer__nav" aria-label="フッターナビゲーション">
      {site.navigation.map((item) => <a class="site-footer__nav-link" href={item.href}>{item.label}</a>)}
    </nav>
    <div class="site-footer__socials">
      {site.socials.map((social) => (
        <a class="site-footer__social" href={social.href} target="_blank" rel="noopener noreferrer" aria-label={`${social.name}を開く（外部サイト）`}>
          <BrandIcon name={social.icon} size={22} />
        </a>
      ))}
    </div>
  </div>
  <div class="site-footer__bottom site-container">
    <p class="site-footer__copyright">© {new Date().getFullYear()} {site.name}</p>
    <a class="site-footer__back" href="#top">PAGE TOP <span aria-hidden="true">↑</span></a>
  </div>
</footer>
